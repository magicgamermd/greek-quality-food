{
  "name": "mertm-warehouse-backend",
  "version": "1.0.0",
  "description": "MERT-M Warehouse Management System — Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && rm -rf dist/fonts && cp -r src/fonts dist/fonts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "vitest run",
    "test:incoming-regression": "vitest run src/__tests__/incoming-review-gate.test.ts src/__tests__/incoming-alias-second-pass.test.ts src/__tests__/incoming-create-product.test.ts src/__tests__/incoming-confirm-inventory.test.ts src/__tests__/incoming-batch-pairing.test.ts src/__tests__/incoming-receipt.test.ts",
    "repair:sync-batch-quantities": "tsx scripts/repair/sync-batch-quantity-from-inventory.ts",
    "reconcile:accepted-invoices-vs-stock": "tsx scripts/reconciliation/accepted-invoices-vs-stock.ts",
    "reconcile:batch-expiry": "tsx scripts/reconciliation/batch-expiry-consistency.ts",
    "reconcile:prices": "tsx scripts/reconciliation/product-price-surface-drift.ts",
    "reconcile": "tsx scripts/reconciliation/run-all.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.1",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^7.0.11",
    "@types/pdfkit": "^0.13.8",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
