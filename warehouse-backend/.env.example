# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
# POSTGRES_* vars are read by docker-compose.yml to initialize the container.
# PG* vars are read by the backend (node-postgres) when it connects.
# Keep the values in sync — user/password/db must match on both sides.
# Host port is 5434 because macOS often has a local Postgres on 5432, Greek
# Foods Docker държи :5432, MERT-M държи :5433. docker-compose maps 5434
# (host) -> 5432 (container) and pins the container to its internal default
# (PGPORT override there).
POSTGRES_USER=greekquality
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=greekquality_warehouse
DATABASE_URL=postgresql://greekquality:CHANGE_ME_DB_PASSWORD@localhost:5434/greekquality_warehouse
PGHOST=localhost
PGPORT=5434
PGUSER=greekquality
PGPASSWORD=CHANGE_ME_DB_PASSWORD
PGDATABASE=greekquality_warehouse

# Redis — Greek Quality Food Redis Docker контейнер на host port 6381
# (Greek Foods държи :6379, MERT-M държи :6380).
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6381

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=8h

# CORS (comma-separated origins, leave empty to allow all)
# CORS_ORIGIN=https://your-app.pages.dev,https://greek-quality-food.bg

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Internal API key for service-to-service auth (AI service → backend)
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

# Email (for invoice sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=invoices@greek-quality-food.bg
SMTP_PASS=your-smtp-password
SMTP_FROM=invoices@greek-quality-food.bg

# Company Info (for invoices)
COMPANY_NAME=Greek Quality Food EOOD
COMPANY_EIK=123456789
COMPANY_VAT=BG123456789
COMPANY_ADDRESS=ul. Example 1, Sofia, Bulgaria
COMPANY_BANK=UniCredit Bulbank
COMPANY_IBAN=BG80UNCR76301078901234
COMPANY_BIC=UNCRBGSF
COMPANY_MOL=Ivan Ivanov

# Econt shipping (https://ee.econt.com)
ECONT_USERNAME=
ECONT_PASSWORD=
ECONT_SENDER_NAME=
ECONT_SENDER_PHONE=
ECONT_SENDER_CITY=София
ECONT_SENDER_POSTCODE=
ECONT_SENDER_QUARTER=
ECONT_SENDER_STREET=
ECONT_SENDER_STREET_NUM=
ECONT_SENDER_OTHER=

# CompanyBook — БГ търговски регистър lookup по ЕИК (за auto-fill на нов партньор).
# Без този ключ /partners/lookup/:eik връща 503.
# Sign up: https://companybook.bg/api-docs
COMPANYBOOK_API_KEY=

# Chat (LLM) — provider for /chat endpoint used by Telegram bot.
# CHAT_PROVIDER: openrouter (default) | ollama
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-3.5-haiku

# Ollama (local) — used when CHAT_PROVIDER=ollama. See .env.ollama.example.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_THINK=false
# OLLAMA_FORMAT=json
# OLLAMA_KEEP_ALIVE=0
# OLLAMA_NUM_CTX=4096
# OLLAMA_TEMPERATURE=0
