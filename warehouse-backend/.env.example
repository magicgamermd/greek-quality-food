# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
# POSTGRES_* vars are read by docker-compose.yml to initialize the container.
# PG* vars are read by the backend (node-postgres) when it connects.
# Keep the values in sync — user/password/db must match on both sides.
# Host port is 5433 because macOS often has a local Postgres on 5432.
# docker-compose maps 5433 (host) -> 5432 (container) and pins the container
# to its internal default (PGPORT override there).
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=mertm_warehouse
DATABASE_URL=postgresql://warehouse:CHANGE_ME_DB_PASSWORD@localhost:5433/mertm_warehouse
PGHOST=localhost
PGPORT=5433
PGUSER=warehouse
PGPASSWORD=CHANGE_ME_DB_PASSWORD
PGDATABASE=mertm_warehouse

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=8h

# CORS (comma-separated origins, leave empty to allow all)
# CORS_ORIGIN=https://your-app.pages.dev,https://mertm.bg

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Internal API key for service-to-service auth (AI service → backend)
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

# Email (for invoice sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=invoices@mertm.bg
SMTP_PASS=your-smtp-password
SMTP_FROM=invoices@mertm.bg

# Company Info (for invoices)
COMPANY_NAME=MERT-M EOOD
COMPANY_EIK=123456789
COMPANY_VAT=BG123456789
COMPANY_ADDRESS=ul. Example 1, Sofia, Bulgaria
COMPANY_BANK=UniCredit Bulbank
COMPANY_IBAN=BG80UNCR76301078901234
COMPANY_BIC=UNCRBGSF
COMPANY_MOL=Ivan Ivanov

# Econt shipping (https://ee.econt.com)
ECONT_USERNAME=
ECONT_PASSWORD=
ECONT_SENDER_NAME=
ECONT_SENDER_PHONE=
ECONT_SENDER_CITY=София
ECONT_SENDER_POSTCODE=
ECONT_SENDER_QUARTER=
ECONT_SENDER_STREET=
ECONT_SENDER_STREET_NUM=
ECONT_SENDER_OTHER=
