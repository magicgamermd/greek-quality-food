# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://greekfoods:greekfoods_secret@localhost:5432/greekfoods_warehouse
PGHOST=localhost
PGPORT=5432
PGUSER=greekfoods
PGPASSWORD=greekfoods_secret
PGDATABASE=greekfoods_warehouse

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=8h

# CORS (comma-separated origins, leave empty to allow all)
# CORS_ORIGIN=https://your-app.pages.dev,https://greekfoods.bg

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Internal API key for service-to-service auth (AI service → backend)
INTERNAL_API_KEY=gf-internal-api-key-change-me

# Email (for invoice sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=invoices@greekfoods.bg
SMTP_PASS=your-smtp-password
SMTP_FROM=invoices@greekfoods.bg

# Company Info (for invoices)
COMPANY_NAME=Greek Foods EOOD
COMPANY_EIK=123456789
COMPANY_VAT=BG123456789
COMPANY_ADDRESS=ul. Example 1, Sofia, Bulgaria
COMPANY_BANK=UniCredit Bulbank
COMPANY_IBAN=BG80UNCR76301078901234
COMPANY_BIC=UNCRBGSF
COMPANY_MOL=Ivan Ivanov
