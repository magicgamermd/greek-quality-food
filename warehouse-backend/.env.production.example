# ============================================================================
# Greek Foods - warehouse-backend production env template
# Copy to .env.production and fill in values. NEVER commit .env.production.
#
# Generating strong secrets: run ./scripts/generate-prod-secrets.sh from the
# repo root to produce a ready-to-paste .env-compatible block for this file.
# ============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Database (PostgreSQL via pgbouncer in production) --------------------
DATABASE_URL=postgres://user:password@pgbouncer:6432/greekfoods_warehouse
POSTGRES_USER=greekfoods
# REQUIRED. Generate with: openssl rand -base64 32
# Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=<RUN: openssl rand -base64 32>
POSTGRES_DB=greekfoods_warehouse

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://:password@redis:6379
# REQUIRED. Generate with: openssl rand -base64 32
# Must match the password embedded in REDIS_URL.
REDIS_PASSWORD=<RUN: openssl rand -base64 32>

# --- Auth / Internal -------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 64   (produces 128-char hex string)
# Rotating this value logs out every active user.
JWT_SECRET=<RUN: openssl rand -hex 64>

# REQUIRED. Generate with: openssl rand -hex 32   (produces 64-char hex string)
# Must match INTERNAL_API_KEY / BACKEND_API_KEY in the ai-service env.
INTERNAL_API_KEY=<RUN: openssl rand -hex 32>

# --- AI service ------------------------------------------------------------
AI_SERVICE_URL=http://ai-service:8000

# --- SMTP (invoice delivery) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=invoices@greekfoods.bg

# --- S3 for PDF storage (P1) -----------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=greekfoods-invoices

# --- Sentry (P1) -----------------------------------------------------------
SENTRY_DSN=
