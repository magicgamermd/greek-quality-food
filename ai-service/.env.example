# ============================================================================
# Greek Foods - ai-service env template
# Copy to .env and fill in values. NEVER commit .env.
# For production deployments generate strong values with:
#   ./scripts/generate-prod-secrets.sh   (from repo root)
# ============================================================================

# --- LLM providers (REQUIRED for OCR pipeline) -----------------------------
# Never commit real keys. Obtain from the provider consoles:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
#   Gemini:    https://aistudio.google.com/apikey
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Redis (Celery broker) -------------------------------------------------
# In production, include the password: redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- Warehouse backend API -------------------------------------------------
WAREHOUSE_API_URL=http://backend:3000

# REQUIRED. Shared secret used for service-to-service auth between
# warehouse-backend and ai-service.
#   - BACKEND_API_KEY is the token ai-service SENDS on outbound calls to
#     warehouse-backend.
#   - INTERNAL_API_KEY is the token ai-service REQUIRES on every incoming
#     /ai/* and /internal/* request (sent by warehouse-backend as
#     `Authorization: Bearer <key>` or `X-Internal-Api-Key: <key>`).
# In practice these should hold the same value.
# Generate with: openssl rand -hex 32
BACKEND_API_KEY=<RUN: openssl rand -hex 32>
INTERNAL_API_KEY=<RUN: openssl rand -hex 32>

# Only this origin is allowed by CORS (browsers). Comma-separated list for
# multiple origins (e.g. staging + prod frontends).
BACKEND_ORIGIN=http://localhost:3004

# --- IMAP (bank statement ingestion) ---------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=payments@greekfoods.bg
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Comarch integration ---------------------------------------------------
COMARCH_API_URL=https://api.comarch.com
COMARCH_CLIENT_ID=
COMARCH_CLIENT_SECRET=
COMARCH_COMPANY_ID=

# --- App settings ----------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
